# Chave da API do Google Gemini (opcional — o sistema também funciona no modo gratuito local com edge-tts)
GEMINI_API_KEY=

# Modelo padrão de texto/pesquisa/análise de Shorts (gemini-2.5-flash ou gemini-2.5-pro)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Modelo padrão de geração de imagens (Nano Banana 2.1 ou gemini-3.1-flash-lite-image)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Modelo padrão de voz Gemini (quando escolher TTS do Gemini em vez de edge-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Voz padrão gratuita (edge-tts) em Português do Brasil
DEFAULT_EDGE_VOICE=pt-BR-AntonioNeural

# Porta do painel Web local
PORT=8765
